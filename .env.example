# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=your-secret-key-here

# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Where Google redirects after login (must match Cloud Console setting)
OAUTH_REDIRECT_URI=http://localhost:5000/oauth/callback

# OpenAI API key (only needed if using Whisper API instead of local model)
OPENAI_API_KEY=your-openai-key-here

# Use 'api' for OpenAI Whisper API, 'local' for local openai-whisper model
WHISPER_MODE=local

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=1
